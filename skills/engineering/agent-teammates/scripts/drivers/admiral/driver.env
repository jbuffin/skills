# Admiral host driver for the agent-teammates scripts, used when ADMIRAL_SHIP is non-empty and HARNESS is claude. The
# operations and their contract are in ../CONTRACT.md. Teammates are Admiral crew boats (`admiral crew launch|send|list|close`),
# so Admiral is the viewer and VIEWER in team.env is ignored. A boat's session id is its crew name.
LIVE_MESSAGING=1
SEND=script
# SKILL_PREFIX is deliberately absent: this driver defers it to the run harness, so commodore's role-skills.sh keeps reading it
# from drivers/$HARNESS.
# Per-session state: none. `status`, `stop` and `tail` read `admiral crew list --json`.
# has-skill, list-skills and advisor-probe run the run harness's operation as is.
