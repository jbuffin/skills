#!/bin/zsh
# usage: launch <team-dir> <name> <workdir> <model> <prompt-file> <read-only: 0|1>   (see ../CONTRACT.md)
# Starts the teammate as an Admiral crew boat running the run harness (HARNESS: claude, codex or copilot). TEAMMATE_ROLE, when
# set, becomes --role. A read-only Codex or Copilot teammate is no crew boat: it is handed to that harness's own driver first
# (headless, so its read-only guarantee holds) and its id goes into <team>/admiral-delegated, for send, stop, status and tail.
# Admiral exits map to the contract's: 5 and 2 (name in use, usage, not in a ship) to 5, anything else to 1. Never exits 2:
# there is no background-session fallback inside a ship.
# Success waits for the boat's first hook (last_activity in `crew list`), up to LAUNCH_WAIT seconds, polling every LAUNCH_POLL. A
# harness at a startup prompt (folder trust, a hook review) never fires one, so the boat is closed and the launch exits 5; a boat
# that exits first is closed and the launch exits 1.
[[ $# -eq 6 ]] || { sed -n 2p $0; exit 5; }
D=${1:A}; NAME=$2; W=$3; CHOSEN=$4; P=$5; RO=; [[ $6 == 1 ]] && RO=1
source ${0:A:h:h:h}/team-env.zsh
source ${0:A:h}/lib.zsh
ROLE=$TEAMMATE_ROLE
# The hand-off comes before every Admiral rule and call: such a teammate is exactly what it is on main, and needs no admiral.
if [[ -n $RO && $HARNESS != claude ]]; then
  [[ -x $HARNESS_DRIVER/launch ]] || { echo "harness $HARNESS has no launch operation ($HARNESS_DRIVER)"; exit 5; }
  OUT=$($HARNESS_DRIVER/launch "$@")
  RC=$?
  (( RC == 2 )) && RC=5   # a host driver never exits 2: there is no background-session fallback inside a ship
  print -r -- "$OUT"
  first=${OUT%%$'\n'*}
  (( RC == 0 )) && print -r -- ${first%% *} >> $D/admiral-delegated
  exit $RC
fi
[[ $LAUNCH_WAIT == <-> ]] || { echo "invalid LAUNCH_WAIT '$LAUNCH_WAIT': use whole seconds (set in team.env or the environment; team.env wins)"; exit 5; }
[[ $LAUNCH_POLL =~ '^[0-9]+(\.[0-9]+)?$' ]] || { echo "invalid LAUNCH_POLL '$LAUNCH_POLL': use a non-negative number of seconds (set in team.env or the environment; team.env wins)"; exit 5; }
[[ $NAME =~ '^[a-z0-9][a-z0-9-]*$' ]] || { echo "invalid teammate name '$NAME': Admiral accepts $NAME_RULE only"; exit 5; }
[[ -z $ROLE || $ROLE =~ '^[a-z0-9][a-z0-9-]*$' ]] || { echo "invalid role '$ROLE': Admiral accepts $NAME_RULE only"; exit 5; }
command -v admiral >/dev/null || { echo "admiral is not on PATH"; exit 1; }
crew_takes_arg || { echo "$OLD_ADMIRAL"; exit 5; }

# Admiral puts the last --arg right before the prompt, so each harness's list ends on a single-value flag: a flag that takes
# several values (claude --disallowedTools, copilot --available-tools and --deny-tool) would read the prompt as one of them.
ARGS=()
case $HARNESS in
  claude)
    [[ -n $RO ]] && ARGS+=(--arg --disallowedTools --arg "Edit(/$W/**)" --arg "NotebookEdit(/$W/**)")
    [[ $ADVISOR != none ]] && ARGS+=(--arg --advisor --arg $ADVISOR)
    ARGS+=(--arg --model --arg $CHOSEN)
    # Under autopilot the boat inherits the dock's mode: Admiral refuses any looser one, and the default (auto) would block every launch.
    [[ $ADMIRAL_AUTOPILOT != 1 ]] && ARGS+=(--arg --permission-mode --arg $PERMISSION_MODE) ;;
  codex)
    # The interactive flags (`codex --help`), not exec's. No trust or -C override: the dock's startup prompts are settled once.
    source $DRIVERS/codex/lib.zsh
    RAW=(-s workspace-write -c sandbox_workspace_write.network_access=true --add-dir $D/reports -m $CHOSEN)
    [[ -n $TEAMMATE_EFFORT ]] && RAW+=(-c "model_reasoning_effort=$(toml_str $TEAMMATE_EFFORT)")
    # -a never: the boat has no one to answer an approval prompt; the sandbox still denies writes outside the workspace.
    RAW+=(-a never)
    ;;
  copilot)
    # The writer flags of drivers/copilot (cp_flags) that the interactive command takes. No -p, -s, --session-id or --trust-folder.
    source $DRIVERS/copilot/lib.zsh
    # The shape check of drivers/copilot/launch: the value becomes a flag value, so no leading '-' and no odd characters.
    [[ -z $TEAMMATE_EFFORT || ( $TEAMMATE_EFFORT != *[^A-Za-z0-9._-]* && $TEAMMATE_EFFORT != -* ) ]] || { echo "effort ${(q-)TEAMMATE_EFFORT} has the wrong shape: use letters, digits, . _ - only, not starting with -; 'copilot --help' lists the values; fix EFFORT_<ROLE> in team.env"; exit 5; }
    cp_extra_dirs $D/team.env
    RAW=(--no-ask-user --allow-all-tools)
    [[ -n $TEAMMATE_EFFORT ]] && RAW+=(--reasoning-effort $TEAMMATE_EFFORT)
    for d in $D ${CP_EXTRA:#$D}; do RAW+=(--add-dir $d); done
    RAW+=(--available-tools bash view edit create glob grep
      --deny-tool 'shell(git push:*)' 'shell(gh pr merge:*)' 'shell(gh pr create:*)' 'shell(gh api:*)' 'shell(gh issue:*)'
      --model $CHOSEN)
    ;;
  *) echo "Admiral crew boats run claude, codex or copilot; HARNESS is '$HARNESS'"; exit 5 ;;
esac
for a in $RAW; do ARGS+=(--arg $a); done
ROLE_ARG=(); [[ -n $ROLE ]] && ROLE_ARG=(--role $ROLE)

OUT=$(admiral crew launch --name $NAME --dir $W --harness $HARNESS $SHIP_ARG $ROLE_ARG $ARGS \
  -- "You are teammate $NAME. Read $P and do exactly what it says." 2>&1)
RC=$?
if (( RC != 0 )); then
  print -r -- "$OUT"
  (( RC == 5 || RC == 2 )) && exit 5
  exit 1
fi
t=$SECONDS
while true; do
  row=$(admiral crew list --json $SHIP_ARG 2>/dev/null | jq -r --arg n $NAME '[.[] | select(.name == $n)]
    | if length == 0 then "missing" else (.[0].state + " " + (.[0].last_activity // "-")) end' 2>/dev/null)
  case $row in
    "") ;;   # the listing failed this time; keep polling until the deadline
    missing|anchored*) admiral crew close $NAME $SHIP_ARG >/dev/null 2>&1
      echo "$NAME exited during startup; board or check \`admiral crew list\`"; exit 1 ;;
    *\ -) ;;
    *) break ;;
  esac
  if (( SECONDS - t >= LAUNCH_WAIT )); then
    admiral crew close $NAME $SHIP_ARG >/dev/null 2>&1
    echo "$NAME showed no activity within ${LAUNCH_WAIT}s: the harness is probably waiting at a startup prompt (folder trust, or a hook review on Codex). Run the dock's harness once in $W's repository, settle the prompt, and launch again."
    exit 5
  fi
  /bin/sleep $LAUNCH_POLL
done
echo "$NAME -"
echo "  board: admiral attach ${ADMIRAL_SHIP} $NAME   ·   list: admiral crew list --ship ${ADMIRAL_SHIP}   ·   output: teammate-tail.sh"
