#!/bin/zsh
# usage: send <team-dir> <session-id> <message-file>   (see ../CONTRACT.md)
[[ $# -eq 3 ]] || { sed -n 2p $0; exit 5; }
D=${1:A}; ID=$2; M=${3:A}
source ${0:A:h:h:h}/team-env.zsh
source ${0:A:h}/lib.zsh
delegate_if send $ID "$@"
command -v admiral >/dev/null || { echo "admiral is not on PATH"; exit 1; }
print -r -- "You are teammate $ID. Read $M and do exactly what it says." | admiral crew send $ID $SHIP_ARG
rc=$?
(( rc == 4 )) && { echo "crew boat $ID is anchored; close it and launch a new teammate"; rc=1; }
exit $(( rc == 9 ? 1 : rc ))
