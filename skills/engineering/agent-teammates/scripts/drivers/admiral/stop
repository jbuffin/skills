#!/bin/zsh
# usage: stop <team-dir> <session-id>   (see ../CONTRACT.md)
# Closes the crew boat when `crew list` shows it. Exits 0 only if it was underway or needs_you; an anchored boat is still
# closed but exits 1, and a boat that isn't listed exits 1 with nothing closed. A read-only Codex/Copilot teammate
# (`delegated`, in lib.zsh) is no crew boat: its harness driver's stop runs instead.
[[ $# -eq 2 ]] || { sed -n 2,4p $0; exit 5; }
D=${1:A}; ID=$2
source ${0:A:h:h:h}/team-env.zsh
source ${0:A:h}/lib.zsh
delegate_if stop $ID "$@"
# A delegated teammate can't be told from a planted id while the listing is down (see `delegated`), so nothing is stopped.
listing=$(admiral crew list --json $SHIP_ARG 2>/dev/null) || { echo "can't list crew boats; nothing stopped"; exit 1; }
state=$(print -r -- "$listing" | jq -r --arg n $ID '.[] | select(.name == $n) | .state // ""' 2>/dev/null) || { echo "can't read the crew list; nothing stopped"; exit 1; }
[[ -n $state ]] || exit 1
admiral crew close $ID $SHIP_ARG >/dev/null 2>&1 || exit 1
[[ $state != anchored ]]
