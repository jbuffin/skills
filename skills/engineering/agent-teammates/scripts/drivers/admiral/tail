#!/bin/zsh
# usage: tail <team-dir> <label> <session-id> <n>   (see ../CONTRACT.md)
# Finds the boat's transcript in `crew list --json` (ADR 0021). Claude: runs the claude driver's tail on it, with the id the
# transcript's basename without .jsonl and CLAUDE_CONFIG_DIR its ../../.. (<config>/projects/<project>/<id>.jsonl). Codex and
# Copilot: their tails can't read a crew boat's transcript (codex needs its state file and `exec --json` events, copilot
# hard-codes ~/.copilot), so this prints the path and the last <n> lines raw, each cut to 300 characters. A read-only
# teammate (`delegated`, in lib.zsh) is no crew boat: its harness driver's tail runs instead.
[[ $# -eq 4 ]] || { sed -n 2,4p $0; exit 5; }
D=${1:A}; W=$2; id=$3; N=$4
source ${0:A:h:h:h}/team-env.zsh
source ${0:A:h}/lib.zsh
delegate_if tail $id "$@"
listing=$(admiral crew list --json $SHIP_ARG 2>/dev/null) || { echo "couldn't list crew boats (admiral crew list --json failed)"; exit 3; }
[[ -n $(print -r -- "$listing" | jq -r --arg n $id '.[] | select(.name == $n) | .name' 2>/dev/null) ]] || { echo "no crew boat $W ($id) in ship $ADMIRAL_SHIP"; exit 3; }
tr=$(print -r -- "$listing" | jq -r --arg n $id '.[] | select(.name == $n) | .transcript // empty')
if [[ $HARNESS != claude ]]; then
  if [[ -z $tr ]]; then
    [[ $HARNESS == copilot ]] && echo "no transcript recorded for $W ($id) yet: Admiral records Copilot's only after the first turn ends" \
      || echo "no transcript recorded for $W ($id) yet: Admiral records it at the boat's first hook"
    exit 3
  fi
  [[ -r $tr ]] || { echo "can't read the transcript of $W ($id): $tr"; exit 3; }
  echo "transcript: $tr"
  # The cut counts characters, not bytes (a byte cut can split a multi-byte one).
  # Split on \n alone (JSON may carry U+2028 raw) and blank the control characters, as drivers/codex/tail does: a transcript
  # line can quote anything, including escape sequences for the coordinator's terminal.
  command tail -n $N $tr | python3 -c 'import re, sys
lines = sys.stdin.buffer.read().decode("utf-8", "replace").split("\n")
if lines and lines[-1] == "": lines.pop()
for line in lines:
    sys.stdout.buffer.write((re.sub("[\x00-\x08\x0b-\x1f\x7f-\x9f]", " ", line)[:300] + "\n").encode("utf-8"))'
  exit 0
fi
[[ -n $tr ]] || { echo "no transcript recorded for $W ($id) yet: Admiral records it at the boat's first hook"; exit 3; }
# The claude tail sources team-env.zsh, and team.env's CLAUDE_CONFIG_DIR (Commodore writes one) would override an environment
# variable. A scratch team dir with a team.env of its own makes the transcript's directory the one it reads.
S=$(mktemp -d) || exit 1
trap 'rm -rf $S' EXIT
print -r -- "CLAUDE_CONFIG_DIR=${(q)tr:h:h:h}" > $S/team.env
$HARNESS_DRIVER/tail $S $W ${${tr:t}%.jsonl} $N
