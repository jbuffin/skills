#!/bin/zsh
# usage: has-skill <team-dir> <name>   (see ../CONTRACT.md)
# Exits 0 when Claude Code can load skill <name> for the run's repo, 1 when it can't. Looks in the installed plugins that
# installed_plugins.json lists for this repo (a `plugin:skill` name names the plugin), the user's skills and the repo's
# .claude/skills and the skills built into the CLI (skills.zsh).
[[ $# -eq 2 ]] || { sed -n 2p $0; exit 5; }
D=${1:A}
[[ -f $D/team.env ]] && source $D/team.env   # REPO and the harness's config dirs; read only, so the run dir is untouched
REPO=${REPO:-$WORKTREE}   # an old team.env has WORKTREE and no REPO
source ${0:A:h}/skills.zsh
n=$2
[[ $n =~ '^[A-Za-z0-9][A-Za-z0-9._:-]*$' ]] || exit 1
p=; s=$n
[[ $n == *:* ]] && { p=${n%%:*}; s=${n#*:}; }
found=(${(M)${(f)"$(skill_list $p)"}:#$s$'\t'*})
(( $#found )) && exit 0 || exit 1
