# Codex driver for the agent-teammates scripts. The contract (the declarations below, the operations and their exit
# codes) is in drivers/claude/driver.env; this file holds only the Codex values. Codex teammates are turn-based
# (docs/adr/0003-codex-teammates-are-turn-based.md). The operations are executables in this directory; until they
# exist, `drv` returns 9 and the callers exit 5.
LIVE_MESSAGING=0
SEND=script
