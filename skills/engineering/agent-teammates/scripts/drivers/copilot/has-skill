#!/bin/zsh
# usage: has-skill <team-dir> <name>   (see ../CONTRACT.md)
# Exits 0 when Copilot CLI can load skill <name> for the run's repo, 1 when it can't. Looks in the repo's .github/skills,
# .agents/skills and .claude/skills, $COPILOT_HOME/skills and ~/.agents/skills, then the CLI's built-in skills and the
# built-in agents behind its slash commands (skills.zsh).
[[ $# -eq 2 ]] || { sed -n 2p $0; exit 5; }
D=${1:A}
[[ -f $D/team.env ]] && source $D/team.env   # REPO and the harness's config dirs; read only, so the run dir is untouched
REPO=${REPO:-$WORKTREE}   # an old team.env has WORKTREE and no REPO
source ${0:A:h}/skills.zsh
n=$2
[[ $n =~ '^[A-Za-z0-9][A-Za-z0-9._:-]*$' ]] || exit 1
found=(${(M)${(f)"$(skill_list)"}:#$n$'\t'*})
(( $#found )) && exit 0 || exit 1
