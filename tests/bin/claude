#!/bin/sh
# Fake `claude` for tests/run.sh. Logs every call (cwd and argv) to $FAKE_LOG and prints canned output modelled on the
# real CLI. Never starts anything. Behaviour comes from files in $FAKE_DIR and these variables:
#   FAKE_AGENTS_FAIL=1   `claude agents ...` exits 1
#   FAKE_BG              ok (default) | notrust | fail | noid: what `claude --bg` does
#   FAKE_BG_ID           the session id `--bg` reports (default c51dbe46)
#   FAKE_BG_ANSI=1       wrap the word "backgrounded" in colour codes
#   FAKE_PROBE           on | off: `--bg` also writes an advisor transcript for the session under $CLAUDE_CONFIG_DIR
#   FAKE_STOP_RC         exit code of `claude stop` (default 0)
# $FAKE_DIR/agents.json is the output of `claude agents --json` (default []). $FAKE_DIR/agents-all.<n>.json is the
# output of the n-th `claude agents --json --all` call; the last file at or below n repeats.
{
  printf 'claude cwd=%s' "$(pwd -P)"
  for a in "$@"; do printf ' [%s]' "$a"; done
  printf '\n'
} >> "${FAKE_LOG:?}"

case "$1" in
  agents)
    if [ -n "$FAKE_AGENTS_FAIL" ]; then
      echo "agents: simulated failure" >&2
      exit 1
    fi
    all=
    for a in "$@"; do
      if [ "$a" = --all ]; then all=1; fi
    done
    if [ -n "$all" ]; then
      n=$(cat "$FAKE_DIR/agents-all.count" 2>/dev/null || echo 0)
      n=$((n + 1))
      echo "$n" > "$FAKE_DIR/agents-all.count"
      while [ "$n" -gt 0 ] && [ ! -f "$FAKE_DIR/agents-all.$n.json" ]; do n=$((n - 1)); done
      if [ "$n" -gt 0 ]; then cat "$FAKE_DIR/agents-all.$n.json"; else echo '[]'; fi
    elif [ -f "$FAKE_DIR/agents.json" ]; then
      cat "$FAKE_DIR/agents.json"
    else
      echo '[]'
    fi
    ;;
  --bg)
    name=; prev=
    for a in "$@"; do
      if [ "$prev" = -n ]; then name=$a; fi
      prev=$a
    done
    id=${FAKE_BG_ID:-c51dbe46}
    case "${FAKE_BG:-ok}" in
      ok)
        if [ -n "$FAKE_BG_ANSI" ]; then
          printf '\033[1mbackgrounded\033[0m · %s · %s\n' "$id" "$name"
        else
          printf 'backgrounded · %s · %s\n' "$id" "$name"
        fi
        case "$FAKE_PROBE" in
          on)
            mkdir -p "$CLAUDE_CONFIG_DIR/projects/p"
            {
              echo '{"type": "assistant", "message": {"content": [{"type": "server_tool_use", "id": "srvtoolu_1", "name": "advisor", "input": {}}]}}'
              echo '{"type": "user", "message": {"content": [{"type": "advisor_tool_result", "tool_use_id": "srvtoolu_1", "content": "yes"}]}}'
            } > "$CLAUDE_CONFIG_DIR/projects/p/$id.jsonl"
            ;;
          off)
            mkdir -p "$CLAUDE_CONFIG_DIR/projects/p"
            echo '{"type": "assistant", "message": {"content": [{"type": "text", "text": "Advisor unavailable (feature_disabled)"}]}}' \
              > "$CLAUDE_CONFIG_DIR/projects/p/$id.jsonl"
            ;;
        esac
        ;;
      notrust)
        echo 'warning: --bg manages the session id; ignoring --session-id' >&2
        echo 'Error: this folder is not trusted yet' >&2
        exit 1
        ;;
      fail)
        echo 'Error: background sessions are disabled' >&2
        exit 1
        ;;
      noid)
        echo 'started'
        ;;
    esac
    ;;
  stop)
    exit "${FAKE_STOP_RC:-0}"
    ;;
esac
exit 0
