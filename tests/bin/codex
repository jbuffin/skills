#!/bin/sh
# Fake `codex` for tests/run.sh. Logs every call (cwd and argv) to $FAKE_LOG and prints events modelled on the real
# `codex exec --json` of codex-cli 0.162.0. Behaviour comes from these variables, or the same-named files in $FAKE_DIR:
#   FAKE_CODEX_THREAD   the thread id of a new session (file codex-thread; default 019e1111-2222-7333-8444-555566667777).
#                       `exec resume <id>` always uses the id it is given.
#   FAKE_CODEX_MODE     (file codex-mode)
#     ok       the turn completes at once (default)
#     fail     the turn fails: turn.failed, no turn.completed, exit 1 (the -o file is still written)
#     hold     thread.started, turn.started, then the process stays until $FAKE_DIR/codex.release exists (or it is
#              killed), then the turn completes like `ok`
#     silent   prints nothing and stays like `hold`
#   FAKE_CODEX_REPORT   what -o gets: text (default, the final message), empty (an empty file) or none (no file)
#   FAKE_CODEX_REPLY    the final agent message (default "All done here")
#   FAKE_CODEX_TOOLS    0: no tool items in the turn (default: two command_execution items)
#   FAKE_CODEX_CHILD    1: once ready, start a `/bin/sleep 60` in a process group of its own, like a tool command (pid in codex.child)
# Every call writes $FAKE_DIR/codex.pid and codex.pgid (the last call wins), and codex.ready once its first events are
# out. A process that stays waits with /bin/sleep (tests/bin/sleep returns at once), for at most 60 s, and also ends when
# $FAKE_DIR is gone. It never closes its stdout or stderr and never starts a session of its own, like the real one.
{
  printf 'codex cwd=%s' "$(pwd -P)"
  for a in "$@"; do printf ' [%s]' "$a"; done
  printf '\n'
} >> "${FAKE_LOG:?}"

if [ "$1" != exec ]; then
  echo "codex: fake supports only 'exec' and 'exec resume' (got: $*)" >&2
  exit 2
fi
shift
resume=
if [ "$1" = resume ]; then
  resume=1
  shift
fi

out=; sid=; prompt=; npos=0
while [ $# -gt 0 ]; do
  case $1 in
    -s | --sandbox | -C | --cd)
      if [ -n "$resume" ]; then
        echo "error: unexpected argument '$1' found" >&2
        echo "Usage: codex exec resume [OPTIONS] [SESSION_ID] [PROMPT]" >&2
        exit 2
      fi
      shift 2 ;;
    -o | --output-last-message) out=$2; shift 2 ;;
    -c | --config | -m | --model | --add-dir | -p | --profile | -i | --image | --color | --output-schema) shift 2 ;;
    -*) if [ "$1" = - ]; then npos=$((npos + 1)); if [ "$npos" -eq 1 ]; then sid=-; else prompt=-; fi; fi; shift ;;
    *) npos=$((npos + 1)); if [ "$npos" -eq 1 ]; then sid=$1; else prompt=$1; fi; shift ;;
  esac
done
# `resume [SESSION_ID] [PROMPT]`; exec has just the prompt.
if [ -z "$resume" ]; then
  prompt=$sid; sid=
elif [ "$npos" -eq 1 ] && [ "$sid" = - ]; then
  prompt=-; sid=
fi
if [ "$prompt" = - ]; then
  msg=$(cat)
  printf 'codex stdin: %s\n' "$(printf '%s' "$msg" | tr '\n' ' ')" >> "$FAKE_LOG"
fi

fval() { # fval <VAR value> <file> <default>
  if [ -n "$1" ]; then printf '%s' "$1"; else cat "$FAKE_DIR/$2" 2>/dev/null || printf '%s' "$3"; fi
}
thread=$(fval "$FAKE_CODEX_THREAD" codex-thread 019e1111-2222-7333-8444-555566667777)
[ -z "$resume" ] || thread=${sid:-$thread}
mode=$(fval "$FAKE_CODEX_MODE" codex-mode ok)
report=$(fval "$FAKE_CODEX_REPORT" codex-report text)
reply=$(fval "$FAKE_CODEX_REPLY" codex-reply "All done here")
tools=$(fval "$FAKE_CODEX_TOOLS" codex-tools 1)

echo $$ > "$FAKE_DIR/codex.pid"
ps -o pgid= -p $$ | tr -d ' ' > "$FAKE_DIR/codex.pgid"
trap 'exit 143' TERM INT HUP
# shellcheck disable=SC2064
trap ": > '$FAKE_DIR/codex.exited.$thread'" EXIT

# The rollout: one file per thread, appended to by every turn.
home=${CODEX_HOME:-$HOME/.codex}
dir=$home/sessions/2026/09/21
mkdir -p "$dir"
roll=$dir/rollout-2026-09-21T13-33-20-$thread.jsonl
printf '{"type":"event_msg","payload":{"type":"task_started","thread":"%s"}}\n' "$thread" >> "$roll"
echo "$roll" > "$FAKE_DIR/codex.rollout"

wait_release() {
  i=0
  while [ -d "$FAKE_DIR" ] && [ ! -e "$FAKE_DIR/codex.release" ] && [ "$i" -lt 600 ]; do
    /bin/sleep 0.1
    i=$((i + 1))
  done
}

echo '2026-09-21T13:33:20.000000Z ERROR rmcp::transport::worker: fake: transport channel closed' >&2
if [ "$mode" = silent ]; then
  : > "$FAKE_DIR/codex.ready"
  wait_release
  exit 0
fi
printf '{"type":"thread.started","thread_id":"%s"}\n' "$thread"
echo '{"type":"turn.started"}'
if [ "$(fval "$FAKE_CODEX_CHILD" codex-child 0)" = 1 ]; then
  python3 -c 'import os; os.setsid(); os.execvp("/bin/sleep", ["/bin/sleep", "60"])' < /dev/null > /dev/null 2>&1 &
  echo $! > "$FAKE_DIR/codex.child"
fi
: > "$FAKE_DIR/codex.ready"
if [ "$mode" = hold ]; then wait_release; fi

if [ "$tools" != 0 ]; then
  echo '{"type":"item.completed","item":{"id":"item_0","type":"agent_message","text":"Reading the brief"}}'
  n=1
  for c in 'ls -la' 'git status'; do
    printf '{"type":"item.started","item":{"id":"item_%s","type":"command_execution","command":"/bin/zsh -lc '"'%s'"'","aggregated_output":"","exit_code":null,"status":"in_progress"}}\n' "$n" "$c"
    printf '{"type":"item.completed","item":{"id":"item_%s","type":"command_execution","command":"/bin/zsh -lc '"'%s'"'","aggregated_output":"","exit_code":0,"status":"completed"}}\n' "$n" "$c"
    n=$((n + 1))
  done
fi
printf '{"type":"item.completed","item":{"id":"item_9","type":"agent_message","text":"%s"}}\n' "$reply"
printf '{"type":"event_msg","payload":{"type":"agent_message","message":"%s"}}\n' "$reply" >> "$roll"
if [ -n "$out" ]; then
  case $report in
    text) printf '%s\n' "$reply" > "$out" ;;
    empty) : > "$out" ;;
  esac
fi
if [ "$mode" = fail ]; then
  echo '{"type":"turn.failed","error":{"message":"fake failure"}}'
  exit 1
fi
echo '{"type":"turn.completed","usage":{"input_tokens":100,"cached_input_tokens":0,"cache_write_input_tokens":0,"output_tokens":10,"reasoning_output_tokens":0}}'
exit 0
