#!/bin/sh
# Fake `copilot` for tests/run.sh, modelled on Copilot CLI 1.0.95. Logs every call (cwd and argv) to $FAKE_LOG, and
# keeps each call's argv NUL-separated in $FAKE_DIR/copilot.call.<n> (first record: the cwd), so the tests can read
# arguments that contain spaces or newlines. A `-p` run creates $HOME/.copilot/session-state/<session-id>/ with an
# events.jsonl (every line has data, id, parentId, timestamp and type) and, while it runs, inuse.<pid>.lock and
# inuse.<pid>.hold. Nothing traps TERM, so a killed run leaves both files behind, as the real CLI does. Any wait calls
# /bin/sleep (tests/bin/sleep returns at once). Every pid goes to $FAKE_DIR/copilot.pids (the run) or
# $FAKE_DIR/copilot.children (its child), so the tests can kill what a scenario leaves alive. Behaviour comes from:
#   FAKE_COPILOT_MODE      exit (default): write the whole turn, print the final message under -s, remove the lock
#                          stay: write the turn up to its tool call, then idle until killed or $FAKE_COPILOT_STAY_MAX
#                                seconds (default 60) have passed
#                          silent: the context-overflow symptom: exit 0, print nothing, write no final message
#                          stderr: like silent, but print the message to stderr
#                          fail: like silent, but print an error to stderr and exit 1
#   FAKE_COPILOT_SAY       the final message (default OK)
#   FAKE_COPILOT_TS        epoch of every event and of events.jsonl's mtime (default $FAKE_NOW, else the real clock)
#   FAKE_COPILOT_DONE      a path: the run creates that file (a teammate's .done marker) before it ends
#   FAKE_COPILOT_CHILD     1: the run starts a child process that outlives it unless the process group is killed
#   FAKE_COPILOT_EVIDENCE  1: the path-guard model, off by default (the fake runs no commands). A `-p` run looks in its
#                          prompt for `<dir>/evidence.sh <team> <name> <label>` (backticks and quotes count as spaces; a
#                          trailing . , ; : or ) on the label is dropped; the first such call wins) and runs that script
#                          in its cwd, before the final message, only when <dir> is exactly one of the --add-dir values
#                          (`--add-dir v` or `--add-dir=v`). Any other run, or a <dir> that isn't added, runs nothing
#                          and leaves no log. The run's output and exit code go to $FAKE_DIR/copilot.evidence.<n>.
#   FAKE_COPILOT_REFUSE    a dir the guard refuses even when it is among the --add-dir values (with
#                          FAKE_COPILOT_EVIDENCE=1): the way to see a driver whose --add-dir list lacks the scripts dir
{
  printf 'copilot cwd=%s' "$(pwd -P)"
  for a in "$@"; do printf ' [%s]' "$a"; done
  printf '\n'
} >> "${FAKE_LOG:?}"
n=1
while ! mkdir "${FAKE_DIR:?}/copilot.claim.$n" 2>/dev/null; do n=$((n + 1)); done
{
  printf '%s\000' "$(pwd -P)"
  for a in "$@"; do printf '%s\000' "$a"; done
} > "$FAKE_DIR/copilot.call.$n"

sid=; has_p=; prompt=; adds=
nl='
'
while [ $# -gt 0 ]; do
  case "$1" in
    --session-id=*) sid=${1#--session-id=} ;;
    --session-id) sid=$2; shift ;;
    --add-dir=*) adds=$adds${1#--add-dir=}$nl ;;
    --add-dir) adds=$adds$2$nl; shift ;;
    -p) has_p=1; prompt=$2; shift ;;
  esac
  shift
done
if [ -z "$has_p" ]; then
  echo "GitHub Copilot CLI 1.0.95"
  exit 0
fi
[ -n "$sid" ] || sid=auto-$$
echo "$$" >> "$FAKE_DIR/copilot.pids"

mode=${FAKE_COPILOT_MODE:-exit}
say=${FAKE_COPILOT_SAY:-OK}
epoch=${FAKE_COPILOT_TS:-${FAKE_NOW:-$(/bin/date -u +%s)}}
iso=$(/bin/date -u -r "$epoch" +%Y-%m-%dT%H:%M:%S.000Z 2>/dev/null || /bin/date -u -d "@$epoch" +%Y-%m-%dT%H:%M:%S.000Z)
tstamp=$(/bin/date -u -r "$epoch" +%Y%m%d%H%M.%S 2>/dev/null || /bin/date -u -d "@$epoch" +%Y%m%d%H%M.%S)

sd=$HOME/.copilot/session-state/$sid
ev=$sd/events.jsonl
if [ -d "$sd" ]; then first=session.resume; else first=session.start; fi
mkdir -p "$sd"
: > "$sd/inuse.$$.lock"
: > "$sd/inuse.$$.hold"

seq=0
event() {  # event <type> <data-json>
  seq=$((seq + 1))
  printf '{"type":"%s","data":%s,"id":"%s-%s","parentId":null,"timestamp":"%s"}\n' "$1" "$2" "$$" "$seq" "$iso" >> "$ev"
}
settime() { TZ=UTC touch -t "$tstamp" "$ev"; }

event "$first" "{\"sessionId\":\"$sid\"}"
event user.message '{"content":"(prompt)"}'
event assistant.turn_start '{"turnId":"0"}'
event assistant.message '{"content":"","toolRequests":[{"toolCallId":"toolu_01","name":"bash"}],"turnId":"0"}'
event tool.execution_start '{"toolCallId":"toolu_01","toolName":"bash","arguments":{"command":"git status","description":"Run git status"},"turnId":"0"}'
event tool.execution_complete '{"toolCallId":"toolu_01","success":true,"result":{"content":"On branch main"},"turnId":"0"}'
settime

if [ -n "$FAKE_COPILOT_CHILD" ]; then
  /bin/sleep 120 > /dev/null 2>&1 &
  echo "$!" >> "$FAKE_DIR/copilot.children"
fi

if [ "${FAKE_COPILOT_EVIDENCE:-}" = 1 ]; then
  ev_call=$(printf '%s' "$prompt" | tr '`"' '  ' | tr "'" ' ' | grep -o '/[^ ]*/evidence\.sh [^ ]* [^ ]* [^ ]*' | head -n 1)
  if [ -n "$ev_call" ]; then
    read -r ev_script ev_team ev_name ev_label <<EOF
$ev_call
EOF
    ev_label=${ev_label%[.,;:)]}
    ev_dir=${ev_script%/evidence.sh}
    case "$nl$adds" in
      *"$nl$ev_dir$nl"*)
        if [ "$ev_dir" != "${FAKE_COPILOT_REFUSE:-}" ]; then
          "$ev_script" "$ev_team" "$ev_name" "$ev_label" > "$FAKE_DIR/copilot.evidence.$n" 2>&1
          echo "rc: $?" >> "$FAKE_DIR/copilot.evidence.$n"
        fi ;;
    esac
  fi
fi

if [ "$mode" = stay ]; then
  i=0
  while [ "$i" -lt $((${FAKE_COPILOT_STAY_MAX:-60} * 10)) ]; do
    /bin/sleep 0.1
    i=$((i + 1))
  done
fi

if [ "$mode" = exit ] || [ "$mode" = stay ]; then
  event assistant.message "{\"content\":\"$say\",\"toolRequests\":[],\"turnId\":\"1\"}"
fi
event assistant.turn_end '{"turnId":"1"}'
event session.shutdown '{"shutdownType":"routine"}'
settime
if [ -n "$FAKE_COPILOT_DONE" ]; then
  : > "$FAKE_COPILOT_DONE"
  TZ=UTC touch -t "$tstamp" "$FAKE_COPILOT_DONE"
fi
rm -f "$sd/inuse.$$.lock" "$sd/inuse.$$.hold"
case "$mode" in
  stderr) echo "$say" >&2 ;;
  fail) echo "error: fake copilot failed" >&2; exit 1 ;;
  silent) ;;
  *) echo "$say" ;;
esac
exit 0
